# ── Core ──────────────────────────────────────────────────────────────────────
# Generate a strong key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-32-byte-hex-string-at-least

DEBUG=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Networking ────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5030,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev default — zero setup):
DATABASE_URL=sqlite+aiosqlite:///./suppliersense.db
# PostgreSQL (production, used by docker-compose):
# DATABASE_URL=postgresql+asyncpg://suppliersense:suppliersense@db:5432/suppliersense

# ── AI providers ──────────────────────────────────────────────────────────────
# Leave OPENAI_API_KEY empty to run with deterministic fallbacks (offline-safe).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepInfra is the recommended provider for Whisper transcription.
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
WHISPER_MODEL=openai/whisper-large-v3

# Force offline-only AI for tests and CI.
MOCK_WHISPER=false
MOCK_LLM=false

# ── Seeding ───────────────────────────────────────────────────────────────────
# Set to true in CI to skip the demo seed on startup.
SKIP_SEED=false

# ── Risk thresholds ───────────────────────────────────────────────────────────
SUPPLIER_RISK_THRESHOLD_HIGH=70
SUPPLIER_RISK_THRESHOLD_MEDIUM=40
DISRUPTION_LOOKBACK_DAYS=90
